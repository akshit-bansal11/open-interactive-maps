{
	"name": "open-interactive-maps",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"data": "node scripts/build-maps.mjs",
		"data:check": "node scripts/check-maps.mjs",
		"data:serve": "node scripts/serve.mjs data",
		"check": "biome check --write . && tsc --noEmit",
		"check:ci": "biome ci . && tsc --noEmit",
		"test": "node --test \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\""
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"next": "^16.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2"
	}
}
